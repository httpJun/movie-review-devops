{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "backend",
    "namespace": "movie-app"
  },
  "spec": {
    "internalTrafficPolicy": "Cluster",
    "ports": [
      {
        "port": 8000,
        "protocol": "TCP",
        "targetPort": 8000
      }
    ],
    "selector": {
      "app": "backend"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}
