{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "frontend",
    "namespace": "movie-app"
  },
  "spec": {
    "internalTrafficPolicy": "Cluster",
    "ports": [
      {
        "port": 3000,
        "protocol": "TCP",
        "targetPort": 3000
      }
    ],
    "selector": {
      "app": "frontend"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}
