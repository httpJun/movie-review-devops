{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "backend-migrate",
    "namespace": "movie-app"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 900,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "migrate",
            "image": "918897411315.dkr.ecr.ap-northeast-2.amazonaws.com/movie-review-backend@sha256:230df5ad23c9d3c70f1cc571769bf1968aa375a1b6f4e3cb218e0b841d5789dc",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "alembic",
              "upgrade",
              "head"
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "movie-app-config"
                }
              },
              {
                "secretRef": {
                  "name": "movie-app-secret"
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": "1000m",
                "memory": "1Gi"
              }
            }
          }
        ]
      }
    }
  }
}
